{
  "name": "chess-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "functions",
    "packages/game-service",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:engine": "npm run build -w @chess-game/chess-engine",
    "build:functions": "npm run build -w functions",
    "test": "vitest run",
    "test:engine": "npm run test -w @chess-game/chess-engine",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "deploy:functions": "npm run build:engine && npm run build:functions && firebase deploy --only functions",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:all": "vitest run --exclude \"**/node_modules/**\" --exclude \"**/dist/**\"",
    "build:server": "npm run build -w chess-game-server"
  },
  "dependencies": {
    "@chess-game/chess-engine": "*",
    "@tailwindcss/vite": "^4.3.3",
    "chessops": "^0.15.1",
    "firebase": "^13.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15",
    "@chess-game/game-service": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
