{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "database": {
      "port": 9100
    },
    "functions": {
      "port": 5101
    },
    "hub": {
      "port": 4500
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}